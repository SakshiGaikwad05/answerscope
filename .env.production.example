# Copy to .env.production (never commit it) and use with:
#   docker compose --env-file .env.production up -d --build
POSTGRES_PASSWORD=change-me-to-a-long-random-password
ANTHROPIC_API_KEY=
# Set to false to stop new sign-ups (e.g. for a private beta)
ALLOW_REGISTRATION=true
QUOTA_VISIBILITY_RUNS_PER_USER_PER_DAY=3
QUOTA_VISIBILITY_RUNS_GLOBAL_PER_DAY=20
