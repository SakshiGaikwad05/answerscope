# Copy to .env.production (never commit it) and use with:
#   docker compose --env-file .env.production up -d --build
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Let users save their own API keys (32+ random characters, e.g. openssl rand -base64 32). Keep it stable.
AEO_SECRETS_KEY=
# false = users must bring their own keys; the provider keys below are never used for them
AEO_USE_SERVER_API_KEYS=true
# AI assistants to test (any subset; leave empty to disable that assistant)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
# Analysis model (question generation, business extraction) via NVIDIA's hosted API
NVIDIA_API_KEY=
# Web search for backlink discovery (or PERPLEXITY_API_KEY)
BRAVE_API_KEY=
# Set to false to stop new sign-ups (e.g. for a private beta)
ALLOW_REGISTRATION=true
QUOTA_VISIBILITY_RUNS_PER_USER_PER_DAY=8
QUOTA_VISIBILITY_RUNS_GLOBAL_PER_DAY=60
