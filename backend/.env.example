# Copy to backend/.env and adjust. Never commit the real .env.

# PostgreSQL connection (SQLAlchemy URL, psycopg 3 driver)
# Use the password you chose when creating the database user (generate one with: openssl rand -hex 24)
DATABASE_URL=postgresql+psycopg://aeo:CHANGE_ME@localhost:5432/aeo

# Comma-separated origins allowed to call the API (the Next.js frontend)
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- AI provider: Anthropic Claude -------------------------------------------
# Leave empty to disable AI visibility tests (the website audit still works).
ANTHROPIC_API_KEY=
# Other options are AEO_-prefixed so shell variables meant for other tools don't leak in.
# AEO_ANTHROPIC_BASE_URL=https://api.anthropic.com
AEO_ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
AEO_ANTHROPIC_EFFORT=medium
# Let Claude search the web (needed to observe website citations)
AEO_ANTHROPIC_WEB_SEARCH=true
AEO_ANTHROPIC_WEB_SEARCH_MAX_USES=3
# Server-side fallback to another model if a request is refused by safety classifiers
AEO_ANTHROPIC_SERVER_FALLBACKS=true

# --- AI provider: OpenAI (ChatGPT via the Responses API + web_search tool) ----
OPENAI_API_KEY=
# AEO_OPENAI_MODEL=gpt-5.5

# --- AI provider: Google Gemini (Interactions API + google_search tool) --------
GEMINI_API_KEY=
# AEO_GEMINI_MODEL=gemini-3.8-flash

# --- AI provider: Perplexity (Agent API; presets include web search) -----------
PERPLEXITY_API_KEY=
# fast | low | medium | high
# AEO_PERPLEXITY_PRESET=low

# Timeout per assistant request (seconds)
# AEO_PROVIDER_TIMEOUT_SECONDS=120

# --- Analysis model: NVIDIA-hosted (OpenAI-compatible) ------------------------
# Used for question generation and extracting which businesses an answer recommends.
# Not an assistant being measured. Falls back to Claude, then to templates.
NVIDIA_API_KEY=
# AEO_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# AEO_NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# --- Web search for backlink & brand-mention discovery -------------------------
# Brave Search API (api-dashboard.search.brave.com). PERPLEXITY_API_KEY also works.
BRAVE_API_KEY=

# --- Users' own API keys ("bring your own key") ----------------------------------
# Encrypts the keys users save on the API keys page. Unset = saving keys is disabled.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AEO_SECRETS_KEY=
# false = never use the provider keys above for users (public deployments: users pay for their own tests)
# AEO_USE_SERVER_API_KEYS=true

# --- Public hosting -------------------------------------------------------------
# Shared secret the frontend sends (BACKEND_PROXY_SECRET there). When set, the API refuses direct calls.
# AEO_PROXY_SECRET=

# --- Crawler limits ------------------------------------------------------------
CRAWL_MAX_PAGES=15
CRAWL_TIMEOUT_SECONDS=10
CRAWL_MAX_BYTES=2000000
# Stop crawling more pages after this many seconds (the audit still completes with what was fetched)
CRAWL_MAX_SECONDS=120
VISIBILITY_MAX_QUESTIONS=20

# --- Accounts & limits ---------------------------------------------------------
ALLOW_REGISTRATION=true
# true when served over HTTPS
COOKIE_SECURE=false
# AI actions per rolling 24 hours (0 disables). Global caps protect your API bill.
QUOTA_VISIBILITY_RUNS_PER_USER_PER_DAY=8
QUOTA_VISIBILITY_RUNS_GLOBAL_PER_DAY=60
QUOTA_QUESTION_GENERATIONS_PER_USER_PER_DAY=10
QUOTA_FIX_GENERATIONS_PER_USER_PER_DAY=20
QUOTA_BACKLINK_DISCOVERIES_PER_USER_PER_DAY=3

# --- Jobs & rendering ---------------------------------------------------------
# inline: jobs run in the API process. worker: run `python -m app.worker` separately.
JOB_MODE=inline
# Render JavaScript-only sites (needs: uv run playwright install chromium-headless-shell)
RENDER_JS=true
RENDER_MAX_PAGES=8
