# Where the Next server proxies /api/* requests (server-side only, never sent to the browser).
BACKEND_URL=http://127.0.0.1:8000

# Optional: extra hostnames allowed to open the dev server (this machine's own IPs are allowed automatically).
# DEV_ALLOWED_ORIGINS=my-laptop.local

# Optional: make the browser call a separately hosted API directly instead of via the proxy.
# That API's CORS_ORIGINS must include this frontend's origin.
# NEXT_PUBLIC_API_URL=https://api.example.com
